OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=openrouter/auto

# Лимиты (все опциональны, показаны значения по умолчанию)
AI_RATE_LIMIT_PER_MINUTE=10
AI_MAX_MESSAGE_CHARS=4000
PROXY_RATE_LIMIT_PER_MINUTE=20
MAX_UPLOAD_MB=100

# Для запуска через run.py (HTTP + HTTPS одновременно)
HTTP_PORT=8000
HTTPS_PORT=8443
# НЕ SSL_CERT_FILE/SSL_KEY_FILE — эти имена заняты системой, см. README
KINDLE_TLS_CERT=certs/cert.pem
KINDLE_TLS_KEY=certs/key.pem
